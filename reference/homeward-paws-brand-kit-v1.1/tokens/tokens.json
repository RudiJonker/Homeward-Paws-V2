{
  "$description": "Homeward Paws design tokens v1.1. Single source of truth: tokens.css, tokens.scss, tailwind.preset.js and react-native/theme/* are generated from this file. Values match docs/04_DESIGN_SYSTEM.md v1.1, the app's src/theme (29 Oct 2026) and the live website stylesheet (17 Nov 2026).",
  "meta": {
    "name": "Homeward Paws",
    "version": "1.1",
    "date": "2026-11-17",
    "owner": "Digitack (Pty) Ltd",
    "contact": "info@digitack.co.za"
  },
  "color": {
    "brand": {
      "primary":        { "$value": "#227A71", "$description": "Teal. Filled buttons, active tab, links, focus ring." },
      "primaryBright":  { "$value": "#2F9488", "$description": "Icons, illustrations, Report button ring, decoration. Not for text." },
      "primaryDark":    { "$value": "#185C55", "$description": "Pressed/hover state, strong headings on tint." },
      "primaryLight":   { "$value": "#E3F2EF", "$description": "Selected backgrounds, tinted tiles, info callouts." },
      "primaryMid":     { "$value": "#D3EAE5", "$description": "Web only: hover on light teal, decorative bands." },
      "accent":         { "$value": "#E8735F", "$description": "Coral. Brand warmth only: logo heart, notification dot, illustration. Never text, never status." },
      "accentLight":    { "$value": "#FCE9E4", "$description": "Coral tile background." },
      "highlight":      { "$value": "#E9B949", "$description": "Mustard. Notification/alert icon tiles. Not for text." },
      "highlightLight": { "$value": "#FBF3DC", "$description": "Mustard tile and warning-callout background." },
      "highlightOnTint":{ "$value": "#6B4E00", "$description": "Text on highlightLight (warning callouts)." }
    },
    "neutral": {
      "background":     { "$value": "#FBF7F2", "$description": "Warm cream page/screen background. Also splash and adaptive-icon background." },
      "surface":        { "$value": "#FFFFFF", "$description": "Cards, sheets, tab bar, inputs." },
      "surfaceMuted":   { "$value": "#F5EFE7", "$description": "Secondary panels, skeletons, input fill." },
      "textPrimary":    { "$value": "#1F2D3D", "$description": "Deep navy. Body and heading text; also the base colour for shadows and overlays." },
      "textSecondary":  { "$value": "#5E6B78", "$description": "Supporting text, inactive tabs." },
      "textOnPrimary":  { "$value": "#FFFFFF", "$description": "Text on teal or navy fills." },
      "textOnDarkMuted":{ "$value": "#C9D3DC", "$description": "Secondary text on navy fills." },
      "border":         { "$value": "#ECE4DA", "$description": "Hairline dividers, card and input borders." },
      "overlay":        { "$value": "rgba(31, 45, 61, 0.48)", "$description": "Modal scrim (navy at 48%)." }
    },
    "feedback": {
      "error":          { "$value": "#B3363C", "$description": "Destructive actions and field errors. Not a status colour." }
    },
    "status": {
      "$description": "Reserved for status meaning only. Always shown with an icon and a text label as well. base = icons, pins, banners; tint = chip/badge background; onTint = chip text and icon.",
      "missing":  { "base": { "$value": "#C8424A" }, "tint": { "$value": "#FBE6E7" }, "onTint": { "$value": "#9A2A31" }, "label": "MISSING",  "icon": "alert-circle" },
      "found":    { "base": { "$value": "#D97820" }, "tint": { "$value": "#FCEEDD" }, "onTint": { "$value": "#8F4A0C" }, "label": "FOUND",    "icon": "shield-home" },
      "sighting": { "base": { "$value": "#2F6FCE" }, "tint": { "$value": "#E3EDFB" }, "onTint": { "$value": "#1D4E9A" }, "label": "SIGHTING", "icon": "eye" },
      "reunited": { "base": { "$value": "#2E8456" }, "tint": { "$value": "#E2F3E9" }, "onTint": { "$value": "#1D5E3B" }, "label": "REUNITED", "icon": "home-heart" },
      "partner":  { "base": { "$value": "#7A5BB0" }, "tint": { "$value": "#EEE7F7" }, "onTint": { "$value": "#55397F" }, "label": "VERIFIED PARTNER", "icon": "check-decagram" },
      "admin":    { "base": { "$value": "#3E5057" }, "tint": { "$value": "#E6EBED" }, "onTint": { "$value": "#2B3A40" }, "label": "(per context, e.g. ARCHIVED)", "icon": "(per context)" }
    },
    "animalStatusMapping": {
      "$description": "Animal profile status reuses the report chips.",
      "safe": "reunited colours, icon home-heart, label SAFE",
      "missing": "missing",
      "in_care": "found", "fostered": "found", "transferred": "found",
      "archived": "admin (slate)", "deceased": "admin (slate)"
    }
  },
  "font": {
    "family": {
      "sans":   { "$value": ["Nunito", "Segoe UI", "Roboto", "Helvetica Neue", "Arial", "sans-serif"], "$description": "The only UI typeface, app and web." },
      "script": { "$value": ["Dancing Script", "Segoe Script", "cursive"], "$description": "Website only: short captions on photos. Never in the app, never for body text." }
    },
    "weight": { "regular": 400, "semibold": 600, "bold": 700, "extrabold": 800, "black": 900 },
    "reactNative": {
      "regular": "Nunito_400Regular",
      "semibold": "Nunito_600SemiBold",
      "bold": "Nunito_700Bold",
      "extraBold": "Nunito_800ExtraBold"
    }
  },
  "typography": {
    "app": {
      "$description": "Sizes in sp (React Native). Respect Android font scaling.",
      "display":      { "size": 28, "lineHeight": 34, "weight": "extraBold" },
      "screenTitle":  { "size": 22, "lineHeight": 28, "weight": "extraBold" },
      "sectionTitle": { "size": 17, "lineHeight": 22, "weight": "bold" },
      "cardTitle":    { "size": 16, "lineHeight": 21, "weight": "bold" },
      "body":         { "size": 15, "lineHeight": 22, "weight": "regular" },
      "bodyStrong":   { "size": 15, "lineHeight": 22, "weight": "semibold" },
      "label":        { "size": 13, "lineHeight": 18, "weight": "bold" },
      "caption":      { "size": 12, "lineHeight": 16, "weight": "semibold" },
      "button":       { "size": 16, "lineHeight": 20, "weight": "bold" },
      "status":       { "size": 11, "lineHeight": 14, "weight": "extraBold", "uppercase": true, "letterSpacing": 0.5 }
    },
    "web": {
      "$description": "CSS px. Body 17px (16px at 560px and below), line-height 1.6; headings line-height 1.15.",
      "body":        { "size": "17px", "sizeSmall": "16px", "lineHeight": 1.6, "weight": 400 },
      "lead":        { "size": "18px-20px", "weight": 600, "color": "textSecondary" },
      "heroTitle":   { "size": "clamp(40px, 5.2vw, 64px)", "weight": 900, "letterSpacing": "-0.01em" },
      "pageTitle":   { "size": "clamp(34px, 5vw, 48px)", "weight": 900 },
      "sectionTitle":{ "size": "clamp(30px, 4vw, 42px)", "weight": 900 },
      "h2":          { "size": "26px", "weight": 900 },
      "h3":          { "size": "19px-23px", "weight": "800-900" },
      "eyebrow":     { "size": "13px", "weight": 800, "letterSpacing": "0.14em", "uppercase": true, "color": "primary" },
      "button":      { "size": "16px", "weight": 800 },
      "chip":        { "size": "12px", "weight": 900, "letterSpacing": "0.06em", "uppercase": true },
      "small":       { "size": "13px-15px", "weight": 600 }
    }
  },
  "space": { "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 20, "xxl": 24, "xxxl": 32, "huge": 40, "giant": 48 },
  "radius": {
    "app": { "sm": 8,  "md": 14, "lg": 18, "xl": 24, "pill": 999 },
    "web": { "sm": 10, "md": 14, "lg": 20, "xl": 28, "pill": 999 },
    "$description": "sm inputs and thumbnails; md buttons; lg cards; xl hero cards and sheets; pill chips; circles are 50%. The website uses a slightly larger scale for desktop sizes."
  },
  "shadow": {
    "app": {
      "card":   { "color": "textPrimary", "opacity": 0.07, "radius": 10, "offsetY": 3, "elevation": 2 },
      "raised": { "color": "textPrimary", "opacity": 0.18, "radius": 12, "offsetY": 5, "elevation": 7 }
    },
    "web": {
      "card":   "0 10px 30px rgba(31, 45, 61, 0.08)",
      "raised": "0 24px 50px rgba(31, 45, 61, 0.18)"
    },
    "$description": "Soft navy shadows only, never black."
  },
  "layout": {
    "app": { "screenMargin": 20, "minTouchTarget": 48 },
    "web": { "maxWidth": "1120px", "gutter": "20px", "sectionPadding": "72px", "sectionPaddingSmall": "52px", "breakpoints": { "lg": "1100px", "md": "900px", "sm": "560px" }, "minButtonHeight": "52px" }
  },
  "icons": {
    "library": "MaterialCommunityIcons (@expo/vector-icons in the app; Material Design Icons on the web)",
    "reportButton": "paw (optionally with a small plus badge)",
    "category": { "dog": "dog", "cat": "cat", "bird": "bird", "horse": "horse", "donkey": "horse", "rabbit": "rabbit", "reptile": "snake", "smallMammal": "rodent", "farmAnimal": "cow", "other": "paw", "unsure": "help" }
  }
}
